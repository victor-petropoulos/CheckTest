{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CheckTest",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CT-INT-001",
              "shortDescription": {
                "text": "assertion-required"
              },
              "fullDescription": {
                "text": "A test should contain at least one executable verification of an observable outcome."
              },
              "properties": {
                "severity": "error",
                "category": "integrity",
                "status": "active",
                "rationale": "A test without an executable assertion verifies nothing, so its verdict would rest on the absence of evidence (SPEC:490-525).",
                "limitations": "Executability after return/throw and inside callbacks is unresolved (plan A7); unestablished assertion constructs are excluded from the count, so a helper-built assertion is not established.",
                "docsUrl": "docs/CHECKTEST_SPEC_v0.3.md#rule-ct-int-001"
              }
            }
          ]
        }
      },
      "properties": {
        "analysisStatus": "SUCCESS",
        "evaluationStatus": "EVALUATED",
        "completeness": "COMPLETE"
      },
      "results": [
        {
          "ruleId": "CT-INT-001",
          "level": "none",
          "message": {
            "text": "CT-INT-001: assertion_count=1 >= 1"
          },
          "properties": {
            "result": "PASS",
            "testId": "<fixture-root>/case-24-vitest-standard/sample.test.ts#it@4:0"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "<fixture-root>/case-24-vitest-standard/sample.test.ts"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        }
      ]
    }
  ]
}