{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CheckTest",
          "version": "0.1.0",
          "rules": [
            {
              "id": "CT-INT-001",
              "shortDescription": {
                "text": "assertion-required"
              },
              "properties": {
                "severity": "error",
                "category": "integrity"
              }
            }
          ]
        }
      },
      "properties": {
        "analysisStatus": "SUCCESS",
        "evaluationStatus": "EVALUATED",
        "completeness": "INCOMPLETE"
      },
      "results": [
        {
          "ruleId": "CT-INT-001",
          "level": "note",
          "message": {
            "text": "CT-INT-001: coverage.status PARTIAL for 'assertion_count' is below required COMPLETE ('it.aliased' is declared through a verified in-file test alias (it); the collector reports it without establishing how it runs)"
          },
          "properties": {
            "result": "INDETERMINATE"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "<fixture-root>/case-25-vitest-aliased/sample.test.ts"
                },
                "region": {
                  "startLine": 6
                }
              }
            }
          ]
        }
      ]
    }
  ]
}